# Telegram Bot API token from @BotFather
BOT_TOKEN=123456789:replace_with_bot_token

# Telegram API credentials from https://my.telegram.org
API_ID=123456
API_HASH=replace_with_api_hash

# A Telethon StringSession generated by generate_session.py
TELETHON_SESSION=replace_with_telethon_string_session

# Channel ID (-100...) or public username (@channel_username)
CHANNEL_ID=-1001234567890

# Local or mounted cache path. Render's ephemeral filesystem is acceptable because
# the bot performs a full sync at startup; use /var/data/... with a persistent disk
# if you want the cache to survive restarts.
CACHE_FILE=data/channel_posts.json

REFRESH_INTERVAL_SECONDS=900
MAX_RESULTS=10
MIN_QUERY_LENGTH=2
LOG_LEVEL=INFO
